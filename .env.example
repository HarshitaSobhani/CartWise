# ---- Server (copy to server/.env for local development) ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cartwise:cartwise@localhost:5432/cartwise
# Optional: without REDIS_URL jobs run in-process (single-node dev only). Required for the worker.
REDIS_URL=redis://localhost:6379
# REQUIRED: >= 16 chars. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
# Set true when served over HTTPS (production)
COOKIE_SECURE=false
# Comma-separated emails that become ADMIN when they register
ADMIN_EMAILS=
# Data older than this is flagged "stale"
STALE_AFTER_HOURS=48
# How often the worker schedules source refreshes (idempotent per interval)
REFRESH_EVERY_MINUTES=1440
RATE_LIMIT_ENABLED=true

# ---- Optional email notifications (disabled unless SMTP_HOST and MAIL_FROM are set) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Seeding ----
# Password for the demo users created by `npm run seed` (default CartWise-Demo-2026)
SEED_PASSWORD=

# ---- Tests (server) ----
# Must contain "test"; tests refuse to run otherwise
TEST_DATABASE_URL=postgresql://cartwise:cartwise@localhost:5432/cartwise_test
